#!/usr/bin/env bash
# Local review gate; enable per clone: git config core.hooksPath .githooks
set -euo pipefail

max_bytes="${MAX_PDF_BYTES:-6291456}" # 6 MiB; raw exports are usually 9–12 MiB.
[[ "$max_bytes" =~ ^[0-9]+$ ]] || { echo "Invalid MAX_PDF_BYTES" >&2; exit 1; }
token_file="$(git rev-parse --git-path pdf-review-approved)"
failed=0

while IFS= read -r -d '' path; do
  case "$path" in
    *.pdf|*.PDF)
      sha="$(git rev-parse ":$path")"
      size="$(git cat-file -s "$sha")"
      sum="$(git cat-file blob "$sha" | shasum -a 256 | cut -d' ' -f1)"
      if [ "$size" -gt "$max_bytes" ]; then
        echo "PDF exceeds ${max_bytes} bytes: $path (compress it or explicitly adjust MAX_PDF_BYTES)" >&2
        failed=1
      fi
      if ! grep -Fxq "$sum"$'\t'"$path" "$token_file" 2>/dev/null; then
        echo "PDF needs human review: $path" >&2
        failed=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$failed" -ne 0 ]; then
  if [ "${ALLOW_UNREVIEWED_PDF:-0}" = 1 ]; then
    echo "WARNING: explicit ALLOW_UNREVIEWED_PDF=1 override; review gate bypassed." >&2
    exit 0
  fi
  echo "Use .agents/skills/pdf-slide-compression/scripts/pdf.sh stage, inspect, then approve." >&2
  exit 1
fi
